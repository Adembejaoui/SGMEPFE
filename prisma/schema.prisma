generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Materiel {
  id            Int                   @id @default(autoincrement())
  reference     String                @unique
  nom           String
  description   String?
  type          MaterielType
  quantiteStock Int                   @default(0)
  seuilAlerte   Int                   @default(0)
  unite         String                @default("unité")
  emplacement   String?
  prixUnitaire  Float?
  adminId       String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  commandes     CommandeStock[]
  admin         User                  @relation("AdminMateriels", fields: [adminId], references: [id])
  utilisations  UtilisationMateriel[]

  @@map("materiels")
}

model UtilisationMateriel {
  id               Int          @id @default(autoincrement())
  materielId       Int
  interventionId   Int
  quantiteUtilisee Int
  motif            String?
  createdAt        DateTime     @default(now())
  intervention     Intervention @relation(fields: [interventionId], references: [idIntervention])
  materiel         Materiel     @relation(fields: [materielId], references: [id])

  @@unique([materielId, interventionId])
  @@map("utilisations_materiel")
}

model CommandeStock {
  id                Int            @id @default(autoincrement())
  materielId        Int
  quantiteCommandee Int
  fournisseur       String?
  statut            StatutCommande @default(EN_ATTENTE)
  dateCommande      DateTime       @default(now())
  dateReception     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  materiel          Materiel       @relation(fields: [materielId], references: [id])

  @@map("commandes_stock")
}

model Equipement {
  id                  Int                  @id @default(autoincrement())
  nom                 String
  marque              String
  modele              String
  numeroSerie         String               @unique
  etat                EtatEquipement       @default(DISPONIBLE)
  localisation        String
  adminId             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  type                EquipmentType
  demandesMaintenance DemandeMaintenance[]
  admin               User?                @relation(fields: [adminId], references: [id])

  @@map("equipements")
}

model DemandeMaintenance {
  description        String
  dateDemande        DateTime            @default(now())
  equipementId       Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  clientId           String
  idDemande          Int                 @id @default(autoincrement())
  priorite           PrioriteDemande
  statut             StatutDemande       @default(EN_ATTENTE)
  technicianId       String?
  client             User                @relation("ClientDemandes", fields: [clientId], references: [id], onDelete: Cascade)
  equipement         Equipement          @relation(fields: [equipementId], references: [id], onDelete: Cascade)
  technician         User?               @relation("TechnicianDemandes", fields: [technicianId], references: [id])
  interventions      Intervention[]      @relation("DemandeInterventions")
  rapportMaintenance RapportMaintenance?

  @@map("demandes_maintenance")
}

model User {
  id                 String               @id @default(cuid())
  firstName          String
  lastName           String
  email              String               @unique
  password           String
  phone              String
  image              String?
  role               Role                 @default(EMPLOYE)
  isActive           Boolean              @default(true)
  mustChangePassword Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  specialization     EquipmentType?
  accounts           Account[]
  demandesCrees      DemandeMaintenance[] @relation("ClientDemandes")
  technicianDemandes DemandeMaintenance[] @relation("TechnicianDemandes")
  equipementsGestion Equipement[]
  interventions      Intervention[]       @relation("TechnicianInterventions")
  materielsGestion   Materiel[]           @relation("AdminMateriels")
  messagesEnvoyes    Message[]            @relation("UserMessages")
  aiChatSessions      AiChatSession[]      @relation("TechnicianAiChats")
  sessions           Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Intervention {
  idIntervention       Int                   @id @default(autoincrement())
  demandeId            Int
  technicianId         String
  description          String                @default("")
  observation          String?
  statut               StatutIntervention    @default(OUVERTE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  demande              DemandeMaintenance    @relation("DemandeInterventions", fields: [demandeId], references: [idDemande], onDelete: Cascade)
  technician           User                  @relation("TechnicianInterventions", fields: [technicianId], references: [id])
  messages             Message[]             @relation("InterventionMessages")
  aiChatSessions       AiChatSession[]      @relation("AiChatIntervention")
  utilisationsMateriel UtilisationMateriel[]

  @@map("interventions")
}

model Message {
  id             String       @id @default(cuid())
  interventionId Int
  senderId       String
  contenu        String
  lu             Boolean      @default(false)
  createdAt      DateTime     @default(now())
  intervention   Intervention @relation("InterventionMessages", fields: [interventionId], references: [idIntervention], onDelete: Cascade)
  sender         User         @relation("UserMessages", fields: [senderId], references: [id])

  @@index([interventionId])
  @@index([senderId])
  @@map("messages")
}

model AiChatSession {
  id              String    @id @default(cuid())
  interventionId  Int
  technicianId    String
  isResolved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  intervention    Intervention @relation("AiChatIntervention", fields: [interventionId], references: [idIntervention], onDelete: Cascade)
  technician      User      @relation("TechnicianAiChats", fields: [technicianId], references: [id])
  messages        AiMessage[]

  @@index([interventionId])
  @@index([technicianId])
  @@unique([interventionId, technicianId])
  @@map("ai_chat_sessions")
}

model AiMessage {
  id              String   @id @default(cuid())
  sessionId       String
  role            AiMessageRole
  contenu         String
  diagnostic      String?
  suggestedActions String?
  createdAt       DateTime @default(now())
  session         AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_chat_messages")
}

enum AiMessageRole {
  TECHNICIEN
  ASSISTANT
}

model RapportMaintenance {
  idRapport         Int                @id @default(autoincrement())
  demandeId         Int                @unique
  diagnostic        String
  actionsEffectuees String
  resultat          String
  dateCreation      DateTime           @default(now())
  dateModification  DateTime           @updatedAt
  demande           DemandeMaintenance @relation(fields: [demandeId], references: [idDemande], onDelete: Cascade)

  @@map("rapports_maintenance")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  ADMIN
  EMPLOYE
  TECHNICIEN
}

enum EquipmentType {
  PRINTER
  NETWORK
  HVAC
  ELECTRICAL
  SECURITY
}

enum PrioriteDemande {
  BASSE
  MOYENNE
  HAUTE
  URGENTE
}

enum StatutDemande {
  EN_ATTENTE
  VALIDEE
  EN_COURS
  TRAITEE
  REJETEE
  ANNULEE
}

enum EtatEquipement {
  DISPONIBLE
  EN_PANNE
  EN_MAINTENANCE
  HORS_SERVICE
}

enum MaterielType {
  PIECE_DETACHEE
  CONSOMMABLE
  OUTIL
}

enum StatutCommande {
  EN_ATTENTE
  RECUE
  ANNULEE
}

enum StatutIntervention {
  OUVERTE
  EN_COURS
  TERMINEE
  ANNULEE
}
